{
    "name": "schema-projet-collectivites-transition-ecologique",
    "title": "Schéma des projets de transition écologique des collectivités",
    "description": "Modèle de données interopérable pour décrire les plans, actions, opérations et financements de transition écologique des collectivités territoriales. Itération v0.2.0 introduisant 3 objets (Plan, Action, Opération), le détail des financements par source, et la suppression des IDs plateforme.",
    "id": "schema-projet-collectivites-transition-ecologique",
    "profile": "tabular-data-package",
    "version": "v0.2.0",
    "created": "2025-04-28",
    "lastModified": "2026-02-25",
    "homepage": "https://github.com/betagouv/schema-projet-collectivites-transition-ecologique",
    "licenses": [
        {
            "title": "Licence Ouverte",
            "name": "etalab-2.0",
            "path": "https://www.etalab.gouv.fr/licence-ouverte-open-licence"
        }
    ],
    "resources": [
        {
            "name": "plans",
            "title": "Plans",
            "description": "Documents stratégiques définissant des orientations et objectifs sur un horizon temporel (PCAET, CRTE, PAT, PLUi...).",
            "profile": "tabular-data-resource",
            "path": "plans/exemple-valide.csv",
            "schema": "plans/schema.json",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8"
        },
        {
            "name": "actions",
            "title": "Actions",
            "description": "Intentions politiques décrivant ce qu'une collectivité envisage d'entreprendre. Objet optionnel.",
            "profile": "tabular-data-resource",
            "path": "actions/exemple-valide.csv",
            "schema": "actions/schema.json",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "foreignKeys": [
                {
                    "fields": ["competencesM57"],
                    "reference": {
                        "resource": "referentiel-competences-m57",
                        "fields": ["code"]
                    }
                },
                {
                    "fields": ["leviersSgpe"],
                    "reference": {
                        "resource": "referentiel-leviers-sgpe",
                        "fields": ["levier"]
                    }
                },
                {
                    "fields": ["planIds"],
                    "reference": {
                        "resource": "plans",
                        "fields": ["id"]
                    }
                },
                {
                    "fields": ["classificationThematiques"],
                    "reference": {
                        "resource": "referentiel-classification-thematiques",
                        "fields": ["label"]
                    }
                }
            ]
        },
        {
            "name": "operations",
            "title": "Opérations",
            "description": "Projets concrets avec moyens engagés, acteurs identifiés, calendrier et livrables. Unité de gestion, pilotage et financement.",
            "profile": "tabular-data-resource",
            "path": "operations/exemple-valide.csv",
            "schema": "operations/schema.json",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "foreignKeys": [
                {
                    "fields": ["competencesM57"],
                    "reference": {
                        "resource": "referentiel-competences-m57",
                        "fields": ["code"]
                    }
                },
                {
                    "fields": ["leviersSgpe"],
                    "reference": {
                        "resource": "referentiel-leviers-sgpe",
                        "fields": ["levier"]
                    }
                },
                {
                    "fields": ["planIds"],
                    "reference": {
                        "resource": "plans",
                        "fields": ["id"]
                    }
                },
                {
                    "fields": ["actionIds"],
                    "reference": {
                        "resource": "actions",
                        "fields": ["id"]
                    }
                },
                {
                    "fields": ["classificationThematiques"],
                    "reference": {
                        "resource": "referentiel-classification-thematiques",
                        "fields": ["label"]
                    }
                },
                {
                    "fields": ["classificationSites"],
                    "reference": {
                        "resource": "referentiel-classification-sites",
                        "fields": ["label"]
                    }
                },
                {
                    "fields": ["classificationInterventions"],
                    "reference": {
                        "resource": "referentiel-classification-interventions",
                        "fields": ["label"]
                    }
                }
            ]
        },
        {
            "name": "financements",
            "title": "Financements",
            "description": "Lignes de financement associées aux opérations. Une opération peut avoir N financements de sources différentes.",
            "profile": "tabular-data-resource",
            "path": "financements/exemple-valide.csv",
            "schema": "financements/schema.json",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "foreignKeys": [
                {
                    "fields": ["operationId"],
                    "reference": {
                        "resource": "operations",
                        "fields": ["id"]
                    }
                }
            ]
        },
        {
            "name": "referentiel-leviers-sgpe",
            "title": "Référentiel des leviers SGPE",
            "description": "Liste des 72 leviers d'action de la planification écologique (SGPE).",
            "profile": "tabular-data-resource",
            "path": "reference-data/referentiel-leviers-sgpe.csv",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "schema": {
                "fields": [
                    {
                        "name": "levier",
                        "type": "string",
                        "title": "Levier",
                        "description": "Nom du levier d'action"
                    },
                    {
                        "name": "description",
                        "type": "string",
                        "title": "Description",
                        "description": "Description détaillée du levier d'action"
                    }
                ],
                "primaryKey": ["levier"]
            }
        },
        {
            "name": "referentiel-competences-m57",
            "title": "Référentiel des compétences M57",
            "description": "Référentiel des compétences selon la nomenclature fonctionnelle M57 (156 entrées).",
            "profile": "tabular-data-resource",
            "path": "reference-data/referentiel-competences-m57.csv",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "schema": {
                "fields": [
                    {
                        "name": "code",
                        "type": "string",
                        "title": "Code",
                        "description": "Code de la compétence",
                        "constraints": {
                            "pattern": "^90-[0-9]{2,3}$"
                        }
                    },
                    {
                        "name": "competence-sous-competence",
                        "type": "string",
                        "title": "Compétence/Sous-compétence",
                        "description": "Libellé de la compétence ou sous-compétence"
                    }
                ],
                "primaryKey": ["code"]
            }
        },
        {
            "name": "referentiel-classification-thematiques",
            "title": "Référentiel de classification — Thématiques",
            "description": "138 labels thématiques pour la classification des opérations et actions (contraignant, FK validée).",
            "profile": "tabular-data-resource",
            "path": "reference-data/referentiel-classification-thematiques.csv",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "schema": {
                "fields": [
                    {
                        "name": "label",
                        "type": "string",
                        "title": "Label",
                        "description": "Libellé de la thématique"
                    }
                ],
                "primaryKey": ["label"]
            }
        },
        {
            "name": "referentiel-classification-sites",
            "title": "Référentiel de classification — Sites",
            "description": "59 labels de types de site pour la classification des opérations (contraignant, FK validée).",
            "profile": "tabular-data-resource",
            "path": "reference-data/referentiel-classification-sites.csv",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "schema": {
                "fields": [
                    {
                        "name": "label",
                        "type": "string",
                        "title": "Label",
                        "description": "Type de site"
                    }
                ],
                "primaryKey": ["label"]
            }
        },
        {
            "name": "referentiel-classification-interventions",
            "title": "Référentiel de classification — Interventions",
            "description": "15 labels de types d'intervention pour la classification des opérations (contraignant, FK validée).",
            "profile": "tabular-data-resource",
            "path": "reference-data/referentiel-classification-interventions.csv",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "schema": {
                "fields": [
                    {
                        "name": "label",
                        "type": "string",
                        "title": "Label",
                        "description": "Type d'intervention"
                    }
                ],
                "primaryKey": ["label"]
            }
        }
    ]
}
